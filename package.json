{
  "name": "ardosia",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on tcp:5173 && electron .\"",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/notas.cjs && tsc -b && vitest run && vite build",
    "dist": "npm run build && electron-builder --publish never --config.directories.output=%TEMP%/ardosia-build",
    "publicar": "npm run build && electron-builder --publish always --config.directories.output=%TEMP%/ardosia-build"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "electron-updater": "^6.8.9",
    "mermaid": "^11.17.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.0",
    "wait-on": "^8.0.0"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true,
    "electron-builder@26.15.3": true
  },
  "productName": "Ardósia",
  "description": "Caderno de estudo local-first: escreva em qualquer ponto da tela.",
  "author": {
    "name": "Erik",
    "email": "erikgds@gmail.com"
  },
  "build": {
    "appId": "com.erikgds.ardosia",
    "productName": "Ardósia",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icone.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "erikgds2",
        "repo": "Nameless_text_editor"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Ardósia",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
